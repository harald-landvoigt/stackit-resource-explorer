# Stage 1: Build Angular application
FROM node:20-alpine AS build
WORKDIR /app

# Install dependencies first for cache layer optimization
COPY frontend/package*.json ./
RUN npm ci --legacy-peer-deps

# Copy sources and build production build
COPY frontend/ ./
RUN npm run build -- --configuration=production

# Stage 2: Nginx server
FROM nginx:alpine
LABEL org.opencontainers.image.source="https://github.com/harald-landvoigt/stackit-resource-explorer"
LABEL org.opencontainers.image.description="STACKIT Resource Explorer Frontend Dashboard"

# Copy built browser bundle from angular output directory
COPY --from=build /app/dist/frontend/browser /usr/share/nginx/html
# Copy custom server configuration
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
