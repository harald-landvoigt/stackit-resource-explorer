# ==============================================================================
# STACKIT Resource Explorer - Environment Configuration
# ==============================================================================

# Path to your STACKIT Service Account JSON keyfile.
# Supports absolute paths (/home/user/sa-key.json) or relative paths (./scraper.json)
# Default if omitted:
#   - Standalone: ./scraper.json (in the same directory as docker-compose.yml)
#   - Local repo: ../../.keys/scraper.json
STACKIT_KEY_FILE=./scraper.json

# Image tag to pull/run from GHCR (default: latest)
# IMAGE_TAG=latest

# PostgreSQL database password (default: stackit)
# DB_PASSWORD=stackit
